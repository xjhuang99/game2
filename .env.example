# Copy: cp .env.example .env

# --- LLM (OpenAI → Gemini → DeepSeek fallback) ---
OPENAI_API_KEY=sk-your-openai-key
GEMINI_API_KEY=your-gemini-api-key
DEEPSEEK_API_KEY=sk-your-deepseek-key

# --- App ---
SECRET_KEY=change-me-in-production
APP_BASE_URL=https://game.xjhuang.com
APP_NAME=ACTR Lab — AI Games
PORT=5001
FLASK_DEBUG=false

# Legacy bootstrap admin (optional; disable in production by changing values)
LEGACY_ADMIN_USER=ACTR2026
LEGACY_ADMIN_PASSWORD=ACTR2026

# --- Gmail SMTP (registration verification emails) ---
# Use a Google App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.name@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=ACTR Lab <your.name@gmail.com>
